{
  "name": "@radlobby-at/radlkarte",
  "description": "Website for desktop, tablet & smartphone usage with the goal to provide useful (route) information for cyclists.",
  "version": "2026.0.0",
  "author": "Markus Straub, Radlobby Östereich (https://radlobby.at)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/markusstraub/radlkarte.git"
  },
  "bugs": {
    "url": "https://github.com/markusstraub/radlkarte/issues"
  },
  "homepage": "https://www.radlkarte.at",
  "private": true,
  "scripts": {
    "start": "why",
    "serve": "http-server -a localhost -p 8081 -c-1",
    "geojson": "./data/prepare_geojson.py",
    "pois": "./data/download_pois_from_osm.py data data/osm-overpass",
    "pois:merge": "./data/merge_pois.py data/osm-overpass data/poi",
    "pois:klagenfurt": "npm run pois -- --only-region klagenfurt",
    "pois:linz": "npm run pois -- --only-region linz",
    "pois:noe-suedost": "npm run pois -- --only-region noe-suedost",
    "pois:rheintal": "npm run pois -- --only-region rheintal",
    "pois:steyr": "npm run pois -- --only-region steyr",
    "pois:wien": "npm run pois -- --only-region wien",
    "lint": "npm run lint:html && npm run lint:js",
    "lint:html": "python3 ./node_modules/html5-lint/html5check.py index.html",
    "lint:js": "jshint radlkarte.js"
  },
  "devDependencies": {
    "html5-lint": "^0.3.0",
    "http-server": "^14.1.1",
    "jshint": "^2.13.6",
    "why": "^0.6.2"
  }
}
