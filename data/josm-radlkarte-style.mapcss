/**
 * radlkarte way attributes:
 * priority=0|1|2 (mandatory)
 * stress=0|1|2 (mandatory)
 * oneway=yes (optional)
 * unpaved=yes, steep=yes (optional)
 *
 * radlkarte problem point attributes and other point categories:
 * one of dismount=yes, nocargo=yes, warning=yes, speed100=yes, leisure=swimming_pool (to render a point)
 * priority=0|1|2 (optional; absent means "not reviewed yet")
 * description=... (free text)
 */

/* stress: 0=calm, 1=medium, 2=stressful */
way[stress=0] {
    opacity: 1;
    color: #004B67;
}
way[stress=1] {
    opacity: 1;
    color: #51A4B6;
}
way[stress=2] {
    opacity: 1;
    color: #FF6600;
}

/* priority (level in route hierarchy): 0=main, 1=regional, 2=local */
way[priority=0] {
    width: 12;
}
way[priority=1] {
    width: 3;
}
way[priority=2] {
    width: 3;
    dashes: 5,5;
}

way[unpaved=yes] {
    casing-width: 7;
    casing-color: #00ff18;
    casing-opacity: 0.75;
}

way[steep=yes] {
    casing-width: 7;
    casing-color: #ff00f0;
    casing-opacity: 0.75;
}

way[fixme] {
    casing-width: 7;
    casing-color: #FF0;
    casing-opacity: 0.5;
}

node[dismount=yes] {
    icon-image: "presets/vehicle/restriction/bicycle.svg";
    text: auto;
}

node[nocargo=yes] {
    icon-image: "presets/vehicle/restriction/maxlength.svg";
    text: auto;
}

node[warning=yes] {
    icon-image: "warning-small.svg";
    text: auto;
}

node[speed100=yes] {
    icon-image: "presets/vehicle/restriction/maxspeed.svg";
    text: auto;
}

node[leisure=swimming_pool] {
    icon-image: "presets/shop/swimming_pool.svg";
    text: auto;
}

/* problem point prominence: 0=most prominent, 1=medium, 2=least */
node[priority=0] {
    icon-width: 24;
}
node[priority=1] {
    icon-width: 18;
}
node[priority=2] {
    icon-width: 12;
}

/* problem points still missing an explicit priority - these need review.
   Drawn on its own subpart: JOSM creates one style element per subpart, so a
   symbol on the default subpart is dropped in favour of icon-image. */
node[dismount=yes][!priority]::priority_review,
node[nocargo=yes][!priority]::priority_review,
node[warning=yes][!priority]::priority_review,
node[speed100=yes][!priority]::priority_review,
node[leisure=swimming_pool][!priority]::priority_review {
    symbol-shape: circle;
    symbol-size: 28;
    symbol-stroke-width: 3;
    symbol-stroke-color: #FFFF00;
    z-index: -1;
}

/* ---------------------------------------------------------------------------
 * Error visualisation. Red means "prepare_geojson.py rejects this, or the map
 * silently drops it". These mirror validate_point_properties() in
 * data/prepare_geojson.py - keep the two in sync when the vocabulary changes.
 *
 * Each rule matches "key present AND value wrong", never "key absent": a point
 * with none of the recognised keys is valid, and a bare [!key] selector would
 * light up every unrelated object when this style is active on plain OSM data.
 * --------------------------------------------------------------------------- */

/* a recognised point attribute carrying a value the validator rejects,
   e.g. dismount=1, warning=2, a free-text warning, leisure=park */
node[dismount][dismount!=yes]::rk_error,
node[nocargo][nocargo!=yes]::rk_error,
node[warning][warning!=yes]::rk_error,
node[speed100][speed100!=yes]::rk_error,
node[leisure][leisure!=swimming_pool]::rk_error,
node[priority][priority!=0][priority!=1][priority!=2]::rk_error {
    symbol-shape: circle;
    symbol-size: 34;
    symbol-stroke-width: 4;
    symbol-stroke-color: #FF0000;
    symbol-fill-color: #FF0000;
    symbol-fill-opacity: 0.25;
    z-index: -2;
}

/* a way attribute carrying a value radlkarte does not accept. The mandatory pair
   must be 0|1|2. The optional flags are only ever read as "yes": radlkarte tests
   them with a strict equality, so oneway=true or unpaved=true silently loses the
   arrows or the dashes.

   oneway=no is deliberately NOT flagged - it is valid OSM meaning "not oneway",
   and radlkarte reads it as such. Only values that are neither yes nor no are
   mistakes here. */
way[priority][priority!=0][priority!=1][priority!=2],
way[stress][stress!=0][stress!=1][stress!=2],
way[unpaved][unpaved!=yes],
way[steep][steep!=yes],
way[oneway][oneway!=yes][oneway!=no] {
    casing-width: 9;
    casing-color: #FF0000;
    casing-opacity: 0.6;
}

/* an unfinished segment: priority and stress are both mandatory, so a way that
   carries route information but is missing either one will not render.

   Scoped to ways that already carry one of the pair, or one of the optional route
   flags, so this stays quiet on foreign OSM data, on the untagged ways JOSM
   exports, and on the administrative boundary ways some region files keep as
   reference geometry. */
way[priority][!stress],
way[stress][!priority],
way[oneway][!priority][!stress],
way[unpaved][!priority][!stress],
way[steep][!priority][!stress] {
    casing-width: 9;
    casing-color: #FF00FF;
    casing-opacity: 0.6;
}
